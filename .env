# =========================================================
# AIMA CGM FLUTTER APP ENVIRONMENT CONFIGURATION
# =========================================================

# Backend API Base URL (Node.js NestJS backend)

# Production / live deployment (ACTIVE):
CGM_API_BASE_URL=https://aima.gms-world.com/

# For physical phone (SM A075F on Wi-Fi), use your PC's Wi-Fi IP:
# CGM_API_BASE_URL=http://192.168.18.57:5000/

# For Windows desktop app testing:
# CGM_API_BASE_URL=http://127.0.0.1:5000/

# For Android emulator:
# CGM_API_BASE_URL=http://10.0.2.2:5000/

# Real-time WebSocket Gateway
CGM_WS_URL=https://aima.gms-world.com/
# CGM_WS_URL=http://192.168.18.57:5000/

# Default App Language (English, Spanish, French, German, Arabic, Urdu, Chinese)
APP_DEFAULT_LANGUAGE=English

# Application Environment Mode (development, staging, production)
APP_ENV=production
